# Azure OpenAI
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# NYT Article Search API — Module 3 news enrichment (free key: https://developer.nytimes.com/get-started)
NYT_API_KEY=your-nyt-api-key

# Sharadar — Module 3 fundamentals + corporate actions (api.sharadar.com directly, NOT proxied
# through Nasdaq Data Link — this var name is a holdover from when it was; see adr/0005 amendment)
# Paid subscription needed. https://sharadar.com/docs/auth
NASDAQ_DATA_LINK_API_KEY=your-sharadar-api-key
